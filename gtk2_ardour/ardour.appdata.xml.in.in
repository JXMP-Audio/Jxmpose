<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@ARDOUR_EXEC@.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0+</project_license>
  <name>JXMPOSE</name>
  <releases>
    <release version="@VERSION@" date="@DATE@" />
  </releases>
  <summary>Digital Audio Workstation</summary>
  <description>
    <p>
      JXMPOSE is a multi-channel digital audio workstation, allowing you to
      record, edit, mix and master audio and MIDI projects. It is based on
      Ardour and adds its own streamlined studio interface.
    </p>
    <p>
      It is targeted at audio engineers, musicians, soundtrack editors and
      composers.
    </p>
  </description>
  <url type="bugtracker">https://github.com/JXMP-Audio/Jxmpose/issues</url>
  <url type="homepage">https://github.com/JXMP-Audio/Jxmpose</url>
  <keywords>
    <keyword>JXMPOSE</keyword>
    <keyword>DAW</keyword>
    <keyword>Digital Audio Workstation</keyword>
    <keyword>Mixing</keyword>
    <keyword>Mastering</keyword>
  </keywords>
</component>
