#!/usr/bin/env python
import os
import re
import sys
import waflib.extras.autowaf as autowaf
import waflib.Utils as Utils

# the JX plugins (JXMP Audio): one bundle, one binary, a ttl per plugin

SOURCES = [
    'jxmp.c',
    'jx-mbc.c',
    'jx-voc.c',
    'jx-pit.c',
    'jx-tun.c',
    'jx-dnr.c',
    'jx-frz.c',
    'jx-hrm.c',
    'jx-spa.c',
    'jx-loop.c',
    'jx-smp.c',
]

def options(opt):
    pass

def configure(conf):
    autowaf.check_pkg(conf, 'lv2', atleast_version='1.0.0', uselib_store='LV2_1_0_0')
    autowaf.check_pkg(conf, 'cairo', uselib_store='CAIRO', atleast_version='1.12.0')
    autowaf.check_pkg(conf, 'sndfile', uselib_store='SNDFILE', atleast_version='1.0.18')

def _load_ttl_module(path):
    sys.path.insert(0, path)
    old = sys.dont_write_bytecode
    sys.dont_write_bytecode = True  # no __pycache__ in the source tree
    try:
        import importlib
        mod = importlib.import_module('ttl')
        importlib.reload(mod)
        return mod
    finally:
        sys.dont_write_bytecode = old
        sys.path.pop(0)

def build(bld):
    bundle = 'jxmp.lv2'
    module_pat = re.sub('^lib', '', bld.env.cshlib_PATTERN)
    module_ext = module_pat[module_pat.rfind('.'):]

    ttl = _load_ttl_module(bld.path.abspath())
    specs = ttl.specs()

    def write_manifest(task):
        task.outputs[0].write(ttl.manifest_ttl(specs, module_ext))

    def write_plugin(task, spec):
        task.outputs[0].write(ttl.plugin_ttl(spec))

    bld(rule   = write_manifest,
        source = 'ttl.py',
        target = '../../LV2/%s/manifest.ttl' % bundle,
        install_path = '${LV2DIR}/%s' % bundle)

    for s in specs:
        bld(rule   = (lambda spec: lambda task: write_plugin(task, spec))(s),
            source = 'ttl.py',
            target = '../../LV2/%s/%s.ttl' % (bundle, s['sym']),
            install_path = '${LV2DIR}/%s' % bundle)

    obj = bld(features     = 'c cshlib',
              source       = SOURCES,
              name         = 'jxmp-plugins',
              cflags       = [ bld.env['compiler_flags_dict']['pic'], bld.env['compiler_flags_dict']['c99'] ],
              includes     = [ '../../ardour', '.' ],
              target       = '../../LV2/%s/jxmp' % bundle,
              install_path = '${LV2DIR}/%s' % bundle,
              uselib       = [ 'CAIRO', 'SNDFILE' ],
              use          = 'LV2_1_0_0',
              lib          = [ 'm' ]
              )
    obj.env.cshlib_PATTERN = module_pat

